<header class="site-header" data-site-header>
  <div class="site-header__inner shell">
    <a class="brand" href="/" aria-label="{{ site.name }} 首页">
      <span class="brand__mark" aria-hidden="true">
        <span class="brand__leaf brand__leaf--one"></span>
        <span class="brand__leaf brand__leaf--two"></span>
        <span class="brand__seed"></span>
      </span>
      <span class="brand__text">
        <span class="brand__name">{{ site.name }}</span>
        <span class="brand__jp">{{ site.jpName }}</span>
      </span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" data-menu-toggle>
      <span class="nav-toggle__label">园内导览</span>
      <span class="nav-toggle__icon" aria-hidden="true"><i></i><i></i></span>
    </button>

    <nav class="site-nav" id="site-navigation" aria-label="主要导航" data-menu>
      <ul class="site-nav__list">
        {% for item in navigation %}
          {% set active = page.url | isActive(item.url) %}
          <li>
            <a class="site-nav__link{% if active %} is-active{% endif %}" href="{{ item.url }}"{% if active %} aria-current="page"{% endif %}>
              <span>{{ item.label }}</span>
              <small>{{ item.en }}</small>
            </a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>
