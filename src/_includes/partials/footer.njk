<footer class="site-footer">
  <div class="site-footer__rule" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="site-footer__inner shell">
    <div>
      <p class="site-footer__name">{{ site.name }}</p>
      <p>{{ site.subtitle }} · EST. {{ site.established }}</p>
    </div>
    <div class="site-footer__notes">
      <p>{{ site.copyrightNotice }}</p>
      <p>© {{ site.established }}–<span data-current-year>{{ site.established }}</span> {{ site.author }}</p>
      <a class="site-footer__basement-link" href="/basement/">
        <span aria-hidden="true">B1</span>
        {{ basement.entryLabel | default("地下室") }}
      </a>
    </div>
    <a class="to-top" href="#top">回到入口 ↑</a>
  </div>
</footer>
