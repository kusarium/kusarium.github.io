<!doctype html>
<html lang="{{ site.language }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#4c4948">
    <meta name="color-scheme" content="light">
    <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
    <meta name="description" content="{{ description | default(site.description) }}">
    <meta name="author" content="{{ site.author }}">
    {% if noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
    <meta property="og:type" content="{% if layout == 'layouts/post.njk' %}article{% else %}website{% endif %}">
    <meta property="og:title" content="{% if title %}{{ title }} · {% endif %}{{ site.name }}">
    <meta property="og:description" content="{{ description | default(site.description) }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:locale" content="{{ site.locale }}">
    {% if cover %}<meta property="og:image" content="{{ site.url }}{{ cover }}">{% endif %}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <link rel="alternate" type="application/rss+xml" title="{{ site.name }} RSS" href="{{ site.url }}/feed.xml">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/assets/fonts/noto-serif-tc/index.css?v=20260811e">
    <link rel="stylesheet" href="/assets/fonts/noto-sans-tc/index.css?v=20260811e">
    <link rel="stylesheet" href="/assets/fonts/noto-serif-sc/index.css?v=20260811e">
    <link rel="stylesheet" href="/assets/fonts/noto-sans-sc/index.css?v=20260811e">
    <link rel="stylesheet" href="/assets/fonts/noto-serif-jp/index.css?v=20260811f">
    <link rel="stylesheet" href="/assets/fonts/noto-sans-jp/index.css?v=20260811f">
    <link rel="stylesheet" href="/assets/css/style.css?v=20260811j">
    <script defer src="/assets/js/site.js?v=20260811i"></script>
    {% if imageCropTool %}<script defer src="/assets/js/image-crop.js?v=20260811a"></script>{% endif %}
  </head>
  <body id="top" class="page page--{{ page.fileSlug | default('home') }}">
    <a class="skip-link" href="#main-content">跳至正文</a>
    <div class="scroll-progress" aria-hidden="true"><span data-scroll-progress></span></div>
    {% include "partials/header.njk" %}
    <main id="main-content">
      {{ content | safe }}
    </main>
    {% include "partials/footer.njk" %}
    <button class="garden-top" type="button" data-back-to-top aria-label="回到頁面頂部">
      <span aria-hidden="true">↑</span>
      <small>TOP</small>
    </button>
  </body>
</html>
