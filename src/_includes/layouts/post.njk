---
layout: layouts/base.njk
---
{% from "partials/archive-cover.njk" import archiveCover %}
{% from "partials/article-toc.njk" import articleToc %}
{% set articleHtml = content | addHeadingIds %}
{% set headings = articleHtml | extractHeadings %}
{% set tocEnabled = showToc | default(true) %}
{% set tocLabel = tocTitle | default("本文目錄", true) %}
{% set isBasement = section == "basement" %}
{% set needsPassword = passwordProtected or isBasement %}
{% set effectivePassword = password %}
{% set effectiveHint = passwordHint %}
{% set accessScope = "article-" ~ page.fileSlug %}
{% set previousArticle = collections.posts | previousPost(page.url) %}
{% set nextArticle = collections.posts | nextPost(page.url) %}
{% if isBasement and not password %}
  {% set effectivePassword = basement.password %}
  {% set effectiveHint = basement.passwordHint %}
  {% set accessScope = "basement" %}
{% endif %}
<article class="article shell shell--article" lang="{{ language | default(site.language) }}">
  {% if not isBasement and previousArticle %}
    <nav class="article-sequence article-sequence--top" aria-label="上一篇文章">
      <a class="article-sequence__link article-sequence__link--previous" href="{{ previousArticle.url }}" rel="prev">
        <span class="article-sequence__mark" aria-hidden="true">↑</span>
        <span class="article-sequence__copy">
          <span class="article-sequence__label">上一篇</span>
          <span class="article-sequence__title" lang="{{ previousArticle.data.language | default(site.language) }}">{{ previousArticle.data.title }}</span>
        </span>
      </a>
    </nav>
  {% endif %}

  <header class="article__header">
    <p class="eyebrow">{% if isBasement %}BASEMENT FILE{% else %}FIELD NOTE{% endif %} · {{ page.date | dateReadable }}</p>
    <h1>{{ title }}</h1>
    {% if excerpt %}<p class="article__lead">{{ excerpt }}</p>{% endif %}
    {% if needsPassword %}
      <p class="entry-lock entry-lock--header"><span aria-hidden="true">⌑</span> 需要密碼 · 提示：{{ effectiveHint | default("未設定提示", true) }}</p>
    {% endif %}
    {% if topics %}
      <ul class="topic-list topic-list--large" aria-label="文章標籤">
        {% for topic in topics %}
          {% if isBasement %}<li><span>#{{ topic }}</span></li>{% else %}<li><a href="/tags/#{{ topic | topicSlug }}">#{{ topic }}</a></li>{% endif %}
        {% endfor %}
      </ul>
    {% endif %}
  </header>

  {% if cover %}
    <figure class="article__cover">
      <button type="button" data-lightbox-trigger data-src="{{ cover }}" data-alt="{{ coverAlt | default(title) }}" aria-label="放大查看圖片">
        <img src="{{ cover }}" alt="{{ coverAlt | default(title) }}" decoding="async">
      </button>
      {% if coverCaption %}<figcaption>{{ coverCaption }}</figcaption>{% endif %}
    </figure>
  {% elif coverCard and coverCard.template %}
    <figure class="article__cover article__cover--archive-card">
      {{ archiveCover(title, topics, coverCard, page.date, "full") }}
    </figure>
  {% endif %}

  {% if needsPassword %}
    <section
      class="password-gate"
      data-password-gate
      data-content-kind="article"
      data-access-scope="{{ accessScope }}"
      data-toc-title="{{ tocLabel | xmlEscape | safe }}"
      {% if tocEnabled %}data-show-toc="true"{% else %}data-show-toc="false"{% endif %}
      data-wrong-message="{{ basement.wrongMessage | default('密碼不對，再想想。') }}"
    >
      <div class="password-gate__panel" data-gate-panel>
        <p class="eyebrow">LOCKED ENTRY</p>
        <h2>這篇記錄已上鎖</h2>
        <p>提示：{{ effectiveHint | default("未設定提示", true) }}</p>
        {% if effectivePassword %}
          <form class="password-gate__form" data-password-form>
            <label for="password-{{ page.fileSlug }}">輸入密碼</label>
            <div>
              <input id="password-{{ page.fileSlug }}" name="password" type="password" autocomplete="current-password" required data-password-input>
              <button class="button button--primary" type="submit">解鎖閱讀</button>
            </div>
            <p class="password-gate__error" role="status" aria-live="polite" data-password-error></p>
          </form>
          <script type="application/json" data-encrypted-payload>{{ articleHtml | encryptContent(effectivePassword) | json | safe }}</script>
        {% else %}
          <p class="password-gate__error">這篇文章尚未在 CMS 設定密碼，正文暫不顯示。</p>
        {% endif %}
      </div>
      <div class="password-gate__output" data-protected-output hidden></div>
    </section>
  {% else %}
    <div class="article__reading-layout{% if not tocEnabled or not headings.length %} article__reading-layout--solo{% endif %}">
      {% if tocEnabled %}{{ articleToc(headings, tocLabel) }}{% endif %}
      <div class="article__content prose">
        {{ articleHtml | safe }}
      </div>
    </div>
  {% endif %}

  <footer class="article__footer">
    <div class="article__seal" aria-hidden="true">K26</div>
    <div>
      <p>記錄於 {{ page.date | dateReadable }}</p>
      {% if isBasement %}<a href="/basement/">← 返回地下室</a>{% else %}<a href="/journal/">← 返回生長記</a>{% endif %}
    </div>
  </footer>

  {% if not isBasement and nextArticle %}
    <nav class="article-sequence article-sequence--bottom" aria-label="下一篇文章">
      <a class="article-sequence__link article-sequence__link--next" href="{{ nextArticle.url }}" rel="next">
        <span class="article-sequence__copy">
          <span class="article-sequence__label">下一篇</span>
          <span class="article-sequence__title" lang="{{ nextArticle.data.language | default(site.language) }}">{{ nextArticle.data.title }}</span>
        </span>
        <span class="article-sequence__mark" aria-hidden="true">↓</span>
      </a>
    </nav>
  {% endif %}

  {% if not isBasement %}
    <nav class="article-mobile-nav" aria-label="文章瀏覽">
      {% if previousArticle %}
        <a class="article-mobile-nav__article article-mobile-nav__article--previous" href="{{ previousArticle.url }}" rel="prev">
          <span class="article-mobile-nav__label">← 上一篇</span>
          <span class="article-mobile-nav__title" lang="{{ previousArticle.data.language | default(site.language) }}">{{ previousArticle.data.title }}</span>
        </a>
      {% endif %}
      <a class="article-mobile-nav__random" href="/journal/" data-random-article aria-label="隨機抽選一篇文章">
        <span aria-hidden="true">✣</span>
        <small>隨機</small>
      </a>
      {% if nextArticle %}
        <a class="article-mobile-nav__article article-mobile-nav__article--next" href="{{ nextArticle.url }}" rel="next">
          <span class="article-mobile-nav__label">下一篇 →</span>
          <span class="article-mobile-nav__title" lang="{{ nextArticle.data.language | default(site.language) }}">{{ nextArticle.data.title }}</span>
        </a>
      {% endif %}
    </nav>
    <script type="application/json" data-article-pool>{{ collections.posts | postUrls | json | safe }}</script>
  {% endif %}
</article>

<dialog class="lightbox" data-lightbox>
  <button class="lightbox__close" type="button" data-lightbox-close aria-label="關閉大圖">×</button>
  <img src="" alt="" data-lightbox-image>
</dialog>
