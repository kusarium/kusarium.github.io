---
layout: layouts/base.njk
title:
description: 小草（クサ）的個人歷史創作網站，收存以北條氏為中心的鎌倉時代插畫、同人小說與隨筆。
---
{% set heroCard = home.archiveCard %}
{% set showHeroCardText = heroCard.showText | default(true) %}
<section class="hero shell" aria-labelledby="hero-title">
  <div class="hero__copy">
    <p class="eyebrow">{{ home.heroEyebrow }} · EST. {{ site.established }}</p>
    <h1 id="hero-title">
      <span>{{ site.name }}</span>
      <small>{{ home.heroSubtitle }}</small>
    </h1>
    <p class="hero__tagline">{{ site.tagline }}</p>
    <p class="hero__intro" lang="ja">{{ home.heroJapanese }}</p>
    <div class="hero__actions">
      <a class="button button--primary" href="/gallery/">{{ navigation.heroActions.galleryLabel }}</a>
      <a class="button button--quiet" href="/journal/">{{ navigation.heroActions.journalLabel }} <span aria-hidden="true">↗</span></a>
    </div>
  </div>

  <div class="hero__specimen" data-hero-parallax>
    <div class="specimen-frame specimen-frame--{{ heroCard.backgroundStyle | default('soft') }}{% if heroCard.backgroundImage %} specimen-frame--has-image{% endif %}" style="--image-focus-x: {{ heroCard.imageFocusX | default(50) }}%; --image-focus-y: {{ heroCard.imageFocusY | default(50) }}%; --image-scale: {{ heroCard.imageZoom | imageScale }};">
      {% if heroCard.backgroundImage %}
        <img class="specimen-frame__image" src="{{ heroCard.backgroundImage }}" alt="{{ heroCard.backgroundAlt | default('') }}" fetchpriority="high">
        {% if heroCard.imageTint | default(true) %}<div class="specimen-frame__image-tint" aria-hidden="true"></div>{% endif %}
      {% endif %}
      {% if showHeroCardText %}
        <div class="specimen-frame__meta">
          <span>{{ heroCard.eyebrow | default('ARCHIVE CARD') }}</span>
          <span>{{ heroCard.number | default('001 / ' + site.established) }}</span>
        </div>
        <div class="specimen-frame__words">
          <span>{{ heroCard.wordOne | default('葉') }}</span>
          <span>{{ heroCard.wordTwo | default('光') }}</span>
          <span>{{ heroCard.wordThree | default('夢') }}</span>
          <span>{{ heroCard.wordFour | default('日常') }}</span>
        </div>
        <div class="specimen-frame__palette" aria-hidden="true"><i></i><i></i><i></i></div>
        <p>{{ heroCard.note | default('COLLECTED SLOWLY') }}</p>
      {% endif %}
    </div>
  </div>

  <a class="hero__scroll" href="#garden-map">
    <span aria-hidden="true"></span>
    {{ navigation.heroActions.archiveEntryLabel }}
  </a>
</section>

<section class="garden-note" id="garden-map">
  <div class="garden-note__inner shell">
    <p class="garden-note__number">01</p>
    <div>
      <p class="eyebrow">{{ home.introduction.eyebrow }}</p>
      <h2>{{ home.introduction.title }}</h2>
      <p class="garden-note__jp-title" lang="ja">{{ home.introduction.titleJapanese }}</p>
    </div>
    <div class="garden-note__copy">
      <p>{{ home.introduction.textChinese }}</p>
      <p lang="ja">{{ home.introduction.textJapanese }}</p>
      <a class="garden-note__link" href="/about/">{{ navigation.heroActions.aboutLabel }}</a>
    </div>
  </div>
</section>

<section class="collection shell section" aria-labelledby="collection-title">
  <div class="section-heading">
    <div>
      <p class="eyebrow">{{ navigation.directory.eyebrow }}</p>
      <h2 id="collection-title">{{ navigation.directory.title }}</h2>
    </div>
    <p>{{ navigation.directory.description }}</p>
  </div>

  <div class="collection-grid">
    <a class="collection-card collection-card--mint" href="/gallery/">
      <span class="collection-card__index">{{ navigation.directory.gallery.index }}</span>
      <div class="collection-card__copy">
        <span class="collection-card__en">{{ navigation.directory.gallery.en }}</span>
        <h3>{{ navigation.directory.gallery.title }}</h3>
        <p>{{ navigation.directory.gallery.description }}</p>
      </div>
      <strong><span>{{ collections.gallery.length | pad2 }}</span><small>{{ navigation.directory.gallery.countLabel }}</small></strong>
      <span class="collection-card__arrow" aria-hidden="true">↗</span>
    </a>
    <a class="collection-card collection-card--yellow" href="/journal/">
      <span class="collection-card__index">{{ navigation.directory.journal.index }}</span>
      <div class="collection-card__copy">
        <span class="collection-card__en">{{ navigation.directory.journal.en }}</span>
        <h3>{{ navigation.directory.journal.title }}</h3>
        <p>{{ navigation.directory.journal.description }}</p>
      </div>
      <strong><span>{{ collections.posts.length | pad2 }}</span><small>{{ navigation.directory.journal.countLabel }}</small></strong>
      <span class="collection-card__arrow" aria-hidden="true">↗</span>
    </a>
    <a class="collection-card collection-card--ink" href="/tags/">
      <span class="collection-card__index">{{ navigation.directory.index.index }}</span>
      <div class="collection-card__copy">
        <span class="collection-card__en">{{ navigation.directory.index.en }}</span>
        <h3>{{ navigation.directory.index.title }}</h3>
        <p>{{ navigation.directory.index.description }}</p>
      </div>
      <strong><span>{{ collections.topicList.length | pad2 }}</span><small>{{ navigation.directory.index.countLabel }}</small></strong>
      <span class="collection-card__arrow" aria-hidden="true">↗</span>
    </a>
  </div>
</section>

<section class="latest shell section" aria-labelledby="latest-title">
  <div class="section-heading">
    <div>
      <p class="eyebrow">{{ navigation.recent.eyebrow }}</p>
      <h2 id="latest-title">{{ navigation.recent.title }}</h2>
    </div>
    <a class="text-link" href="/journal/">{{ navigation.recent.linkLabel }}</a>
  </div>

  <div class="post-grid">
    {% for post in collections.posts | take(3) %}
      {% include "partials/post-card.njk" %}
    {% endfor %}
  </div>
</section>

<section class="keeper shell section">
  <div class="keeper__card">
    {% if keeper.about.portraitImage %}
      <img class="keeper__image" style="--image-focus-x: {{ keeper.about.portraitFocusX | default(50) }}%; --image-focus-y: {{ keeper.about.portraitFocusY | default(50) }}%; --image-scale: {{ keeper.about.portraitZoom | imageScale }};" src="{{ keeper.about.portraitImage }}" alt="{{ keeper.about.portraitAlt | default('') }}" loading="lazy">
    {% else %}
      <div class="keeper__seal" aria-hidden="true">K<br>26</div>
    {% endif %}
    <div>
      <p class="eyebrow">{{ keeper.home.eyebrow }}</p>
      <h2>{{ keeper.home.title }}</h2>
      <p>{{ keeper.home.summary }}</p>
    </div>
    <a class="button button--quiet" href="/about/">{{ keeper.home.buttonLabel }}</a>
  </div>
</section>
