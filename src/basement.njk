---
layout: layouts/base.njk
title: 地下室
description: 需要密碼才能進入的翻譯內容存檔。
permalink: /basement/index.html
noindex: true
excludeFromSitemap: true
---
{% set basementHtml %}
  <section class="basement-list" aria-label="地下室存檔">
    <div class="section-heading">
      <div>
        <p class="eyebrow">RESTRICTED FILES</p>
        <h2>{{ site.basement.listTitle | default("存檔內容") }}</h2>
      </div>
      <p>{{ collections.basement.length }} FILES</p>
    </div>
    {% if collections.basement.length %}
      <ol class="journal-list journal-list--basement">
        {% for post in collections.basement %}
          {% set itemHint = post.data.passwordHint %}
          {% if not post.data.password %}{% set itemHint = site.basement.passwordHint %}{% endif %}
          <li lang="{{ post.data.language | default(site.language) }}">
            <time datetime="{{ post.date | dateIso }}">{{ post.date | dateReadable }}</time>
            <div>
              <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
              {% if post.data.excerpt %}<p>{{ post.data.excerpt }}</p>{% endif %}
              <p class="entry-lock"><span aria-hidden="true">⌑</span> 需要密碼 · 提示：{{ itemHint | default("未設定提示", true) }}</p>
            </div>
            <ul class="topic-list" aria-label="文章標籤">
              {% for topic in post.data.topics %}<li><span>#{{ topic }}</span></li>{% endfor %}
            </ul>
          </li>
        {% endfor %}
      </ol>
    {% else %}
      <p class="basement-list__empty">這裡目前還沒有存檔。</p>
    {% endif %}
  </section>
{% endset %}

<header class="page-intro shell page-intro--split">
  <div>
    <p class="eyebrow">{{ site.basement.eyebrow | default("RESTRICTED ARCHIVE") }}</p>
    <h1>{{ site.basement.title | default("地下室") }}</h1>
  </div>
  <p>{{ site.basement.description | default("翻譯內容的非公開存檔。") }}</p>
</header>

<section
  class="password-gate password-gate--page shell section"
  data-password-gate
  data-content-kind="basement"
  data-access-scope="basement"
  data-wrong-message="{{ site.basement.wrongMessage | default('密碼不對，再想想。') }}"
>
  <div class="password-gate__panel" data-gate-panel>
    <p class="eyebrow">ACCESS REQUIRED</p>
    <h2>{{ site.basement.gateTitle | default("進入地下室") }}</h2>
    <p>提示：{{ site.basement.passwordHint | default("未設定提示", true) }}</p>
    {% if site.basement.password %}
      <form class="password-gate__form" data-password-form>
        <label for="basement-password">輸入密碼</label>
        <div>
          <input id="basement-password" name="password" type="password" autocomplete="current-password" required data-password-input>
          <button class="button button--primary" type="submit">{{ site.basement.buttonLabel | default("進入地下室") }}</button>
        </div>
        <p class="password-gate__error" role="status" aria-live="polite" data-password-error></p>
      </form>
      <script type="application/json" data-encrypted-payload>{{ basementHtml | encryptContent(site.basement.password) | json | safe }}</script>
    {% else %}
      <p class="password-gate__error">尚未在 CMS 設定地下室密碼。</p>
    {% endif %}
  </div>
  <div class="password-gate__output" data-protected-output hidden></div>
</section>
