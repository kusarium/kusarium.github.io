---
layout: layouts/base.njk
title: 生長記
description: KUSARIUM 的圖文、隨筆與日常記錄。
permalink: /journal/index.html
eleventyComputed:
  title: "{{ pageHeaders.journal.title }}"
  description: "{{ pageHeaders.journal.description }}"
---
<header class="page-intro shell page-intro--split">
  <div>
    <p class="eyebrow">{{ pageHeaders.journal.eyebrow }}</p>
    <h1>{{ pageHeaders.journal.title }}</h1>
  </div>
  <p>{{ pageHeaders.journal.description }}</p>
</header>

<section class="journal shell section" aria-label="全部生長記錄">
  <div class="journal__rule">
    <span>DATE</span><span>FIELD NOTES</span><span>SPECIES</span>
  </div>
  <ol class="journal-list">
    {% for post in collections.posts %}
      <li lang="{{ post.data.language | default(site.language) }}">
        <time datetime="{{ post.date | dateIso }}">{{ post.date | dateReadable }}</time>
        <div>
          <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
          {% if post.data.excerpt %}<p>{{ post.data.excerpt }}</p>{% endif %}
          {% if post.data.passwordProtected %}
            <p class="entry-lock"><span aria-hidden="true">⌑</span> 需要密碼 · 提示：{{ post.data.passwordHint | default("未設定提示", true) }}</p>
          {% endif %}
        </div>
        <ul class="topic-list" aria-label="文章標籤">
          {% for topic in post.data.topics %}
            <li><a href="/tags/#{{ topic | topicSlug }}">#{{ topic }}</a></li>
          {% endfor %}
        </ul>
      </li>
    {% endfor %}
  </ol>
</section>

<aside class="archive-callout shell">
  <p><span aria-hidden="true">⌁</span> 想依時間翻找？</p>
  <a href="/archive/">打開年月歸檔 →</a>
</aside>
