---
layout: layouts/base.njk
title: 年月歸檔
description: 依年份瀏覽 KUSARIUM 的全部記錄。
permalink: /archive/index.html
eleventyComputed:
  title: "{{ pageHeaders.archive.title }}"
  description: "{{ pageHeaders.archive.description }}"
---
<header class="page-intro shell">
  <p class="eyebrow">{{ pageHeaders.archive.eyebrow }}</p>
  <h1>{{ pageHeaders.archive.title }}</h1>
  <p>{{ pageHeaders.archive.description }}</p>
</header>

<section class="archive shell section">
  {% for group in collections.posts | groupByYear %}
    <div class="archive-year">
      <div class="archive-year__heading">
        <span>{{ group.year }}</span>
        <small>{{ group.posts.length }} RECORDS</small>
      </div>
      <ol>
        {% for post in group.posts %}
          <li>
            <time datetime="{{ post.date | dateIso }}">{{ post.date | dateReadable }}</time>
            <a href="{{ post.url }}" lang="{{ post.data.language | default(site.language) }}">{{ post.data.title }}</a>
            {% if post.data.cover or (post.data.coverCard and post.data.coverCard.template) %}<span class="archive-year__image" aria-label="含封面">▧</span>{% endif %}
          </li>
        {% endfor %}
      </ol>
    </div>
  {% endfor %}
</section>
